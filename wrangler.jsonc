{
  "name": "joyo",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/joyo/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "kv_namespaces": [{ "binding": "RESULTS", "id": "5b6e157d9203496a86290768b06661b3" }],
  "routes": [
    { "pattern": "build40for40.com/joyo", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/joyo/*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": true,
  "preview_urls": true
}
