{
  "name": "joyo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:web": "vite",
    "dev:api": "mkdir -p dist && npm run wrangler -- dev",
    "fake": "vite --mode fake",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "build-only": "rm -rf dist && vite build",
    "type-check": "vue-tsc --build",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40",
    "deploy": "npm run build && npm run wrangler -- deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/vue": "^4.0.159",
    "@workos-inc/authkit-js": "^0.20.5",
    "ai": "^7.0.159",
    "jose": "^6.2.15",
    "vue": "^3.5.42",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
